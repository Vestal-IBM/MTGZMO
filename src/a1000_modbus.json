{
  "device": "Yaskawa A1000 AC Drive",
  "protocol": "MEMOBUS/Modbus RTU",
  "notes": [
    "Default slave address: 1F (hex) = 31 (dec). Configurable via parameter H5-01.",
    "Broadcast address 00 is write-only; no response is returned.",
    "Default baud rate: 9600 bps (H5-02). Supported: 1200, 2400, 4800, 9600, 19200, 38400 bps.",
    "Default data format: 8-N-2 (H5-03). Options: 8-N-1, 8-E-1, 8-O-1, 8-N-2.",
    "Register addresses are 0-based in the PDU (subtract 1 from any 1-based Modbus table address).",
    "Frequency reference and monitor values are in units of 0.01 Hz unless the drive is set to user units.",
    "All multi-register values are big-endian (high byte first).",
    "Parameters are accessed via the register address corresponding to the parameter number.",
    "Example: parameter H5-01 (slave address) maps to register 0x0320 + offset."
  ],
  "communication_parameters": {
    "H5-01": { "name": "Drive Slave Address",       "range": "0–1F (hex)",  "default": "1F" },
    "H5-02": { "name": "Baud Rate",                 "range": "0–5",         "default": "3",  "map": { "0": "1200", "1": "2400", "2": "4800", "3": "9600", "4": "19200", "5": "38400" } },
    "H5-03": { "name": "Communication Parity",      "range": "0–2",         "default": "0",  "map": { "0": "8-N-2", "1": "8-E-1", "2": "8-O-1", "3": "8-N-1" } },
    "H5-04": { "name": "Stopping Method on Error",  "range": "0–3",         "default": "3" },
    "H5-05": { "name": "Communication Fault Detection", "range": "0–1",     "default": "1" },
    "H5-06": { "name": "Drive Transmit Wait Time",  "range": "5–65 ms",     "default": "5" },
    "H5-07": { "name": "RTS Control",               "range": "0–1",         "default": "1" }
  },
  "function_codes": {
    "01": { "name": "Read Coil Status",               "description": "Read coil (discrete output) ON/OFF status. Returns 1 bit per coil." },
    "02": { "name": "Read Input Status",              "description": "Read discrete input status. Returns 1 bit per input." },
    "03": { "name": "Read Holding Registers",         "description": "Read one or more 16-bit holding registers. Used for monitors and parameters." },
    "06": { "name": "Write Single Register",          "description": "Write a single 16-bit holding register. Used for command word, frequency reference, or a single parameter." },
    "08": { "name": "Loopback Test",                  "description": "Diagnostics loopback. Sub-function 0x0000 echoes the data word back unchanged." },
    "10": { "name": "Write Multiple Registers (16)",  "description": "Write multiple consecutive 16-bit holding registers in one message." },
    "03_broadcast": { "note": "Read functions (01, 02, 03) cannot use broadcast address 00. Write functions (06, 10) may use address 00 with no response." }
  },
  "command_registers": {
    "description": "Write these registers to control the drive. Effective only when b1-02 (Run Command Source) = 2 (Modbus) and b1-01 (Frequency Reference Source) = 2 (Modbus).",
    "registers": {
      "0001": {
        "name": "Command Register (MEMOBUS Command Word)",
        "address_hex": "0001",
        "address_dec": 1,
        "access": "R/W",
        "description": "Primary drive control word. Write to command run, stop, direction, fault reset.",
        "bits": {
          "0": { "name": "Forward Run",         "description": "1 = Run forward. Bit 1 must be 0." },
          "1": { "name": "Reverse Run",         "description": "1 = Run reverse. Bit 0 must be 0." },
          "2": { "name": "External Fault (EF0)","description": "1 = Trigger external fault EF0." },
          "3": { "name": "Fault Reset",         "description": "1 = Reset active fault (rising edge)." },
          "4": { "name": "Multi-step Ref Bit 0","description": "Speed reference selection bit 0 (when d1 multi-step is configured)." },
          "5": { "name": "Multi-step Ref Bit 1","description": "Speed reference selection bit 1." },
          "6": { "name": "Jog Command",         "description": "1 = Jog reference selected." },
          "7": { "name": "Accel/Decel Select",  "description": "1 = Use accel/decel time 2." },
          "8": { "name": "Baseblock (N.O.)",    "description": "1 = Baseblock output (coast to stop)." },
          "9": { "name": "Torque Reference",    "description": "1 = Switch to torque reference (OLV/CLV modes)." },
          "10": { "name": "Speed/Torque Sel",   "description": "1 = Torque control active." },
          "11": { "name": "Emergency Stop",     "description": "1 = Emergency stop (EF0)." },
          "12": { "name": "KEB (Kinetic E. Brake)", "description": "1 = Activate KEB." },
          "13": { "name": "Drive Enable",       "description": "1 = Drive enabled (used with drive enable function)." },
          "14": { "name": "Reserved",           "description": "Set to 0." },
          "15": { "name": "Reserved",           "description": "Set to 0." }
        }
      },
      "0002": {
        "name": "Frequency Reference",
        "address_hex": "0002",
        "address_dec": 2,
        "access": "R/W",
        "description": "Speed/frequency setpoint. Units: 0.01 Hz per count (e.g. 6000 = 60.00 Hz). Range: 0–40000 (0–400.00 Hz). Effective only when b1-01 = 2.",
        "units": "0.01 Hz",
        "example": "6000 = 60.00 Hz"
      },
      "0003": {
        "name": "PID Feedback Reference (via Modbus)",
        "address_hex": "0003",
        "address_dec": 3,
        "access": "R/W",
        "description": "PID feedback setpoint when Modbus is selected as PID feedback source.",
        "units": "0.01% of max frequency"
      }
    }
  },
  "status_registers": {
    "description": "Read these registers to monitor drive state.",
    "registers": {
      "0020": {
        "name": "Status Register (MEMOBUS Status Word)",
        "address_hex": "0020",
        "address_dec": 32,
        "access": "R",
        "description": "Primary drive status word.",
        "bits": {
          "0":  { "name": "During Run",           "description": "1 = Drive is running (output active)." },
          "1":  { "name": "Zero Speed",            "description": "1 = Output frequency is at zero speed level." },
          "2":  { "name": "Reverse Running",       "description": "1 = Drive is running in reverse direction." },
          "3":  { "name": "Reset",                 "description": "1 = Drive has been reset." },
          "4":  { "name": "Speed Agree",           "description": "1 = Output frequency matches frequency reference (within agree width)." },
          "5":  { "name": "Drive Ready",           "description": "1 = Drive is ready to run (no fault, not in baseblock)." },
          "6":  { "name": "Minor Fault (Alarm)",   "description": "1 = Alarm active (non-trip condition)." },
          "7":  { "name": "Major Fault",           "description": "1 = Fault active (drive tripped)." },
          "8":  { "name": "oPE Fault",             "description": "1 = Operator programming error present." },
          "9":  { "name": "UV (Undervoltage)",     "description": "1 = DC bus undervoltage detected." },
          "10": { "name": "Baseblock",             "description": "1 = Output is in baseblock (transistors off)." },
          "11": { "name": "Frequency Reference from Modbus", "description": "1 = Frequency reference source is Modbus." },
          "12": { "name": "Run Command from Modbus",         "description": "1 = Run command source is Modbus." },
          "13": { "name": "During Overtorque/Undertorque",   "description": "1 = Overtorque or undertorque detection active." },
          "14": { "name": "Frequency Reference Loss",        "description": "1 = Frequency reference signal loss detected." },
          "15": { "name": "Reserved",              "description": "Always 0." }
        }
      },
      "0021": {
        "name": "Fault Code",
        "address_hex": "0021",
        "address_dec": 33,
        "access": "R",
        "description": "Active fault code. 0 = no fault. See fault code table.",
        "note": "See fault_codes section for values."
      },
      "0022": {
        "name": "Alarm Code",
        "address_hex": "0022",
        "address_dec": 34,
        "access": "R",
        "description": "Active alarm (minor fault) code. 0 = no alarm."
      },
      "0023": {
        "name": "Drive Status 2",
        "address_hex": "0023",
        "address_dec": 35,
        "access": "R",
        "description": "Secondary status word.",
        "bits": {
          "0":  { "name": "KEB Active",            "description": "1 = KEB (Kinetic Energy Braking) is active." },
          "1":  { "name": "During Deceleration",   "description": "1 = Drive is decelerating." },
          "2":  { "name": "During Acceleration",   "description": "1 = Drive is accelerating." },
          "3":  { "name": "During Speed Search",   "description": "1 = Speed search is active." },
          "4":  { "name": "EF0 Active",            "description": "1 = External fault EF0 triggered." },
          "5":  { "name": "Reserved",              "description": "Always 0." },
          "6":  { "name": "Reserved",              "description": "Always 0." },
          "7":  { "name": "Reserved",              "description": "Always 0." }
        }
      }
    }
  },
  "monitor_registers": {
    "description": "Read-only monitor values. Use function code 03 to read.",
    "registers": {
      "0025": {
        "name": "Output Frequency",
        "address_hex": "0025",
        "address_dec": 37,
        "access": "R",
        "units": "0.01 Hz",
        "range": "0–40000",
        "description": "Actual output frequency to motor. 6000 = 60.00 Hz."
      },
      "0026": {
        "name": "Output Current",
        "address_hex": "0026",
        "address_dec": 38,
        "access": "R",
        "units": "0.1 A",
        "description": "Actual output current. 100 = 10.0 A."
      },
      "0027": {
        "name": "Output Voltage Reference",
        "address_hex": "0027",
        "address_dec": 39,
        "access": "R",
        "units": "0.1 V",
        "description": "Output voltage reference value. 2400 = 240.0 V."
      },
      "0028": {
        "name": "DC Bus Voltage",
        "address_hex": "0028",
        "address_dec": 40,
        "access": "R",
        "units": "1 V",
        "description": "DC bus voltage."
      },
      "002A": {
        "name": "Output Power",
        "address_hex": "002A",
        "address_dec": 42,
        "access": "R",
        "units": "0.1 kW",
        "description": "Output power. 100 = 10.0 kW."
      },
      "002C": {
        "name": "Torque Reference / Estimated Torque",
        "address_hex": "002C",
        "address_dec": 44,
        "access": "R",
        "units": "0.1%",
        "description": "Torque reference or estimated torque as a percentage of rated motor torque."
      },
      "002D": {
        "name": "Frequency Reference Monitor",
        "address_hex": "002D",
        "address_dec": 45,
        "access": "R",
        "units": "0.01 Hz",
        "description": "Active frequency reference (from whatever source is selected)."
      },
      "002F": {
        "name": "Drive Temperature (Heatsink)",
        "address_hex": "002F",
        "address_dec": 47,
        "access": "R",
        "units": "1 °C",
        "description": "Heatsink temperature."
      },
      "0040": {
        "name": "Cumulative Operation Time",
        "address_hex": "0040",
        "address_dec": 64,
        "access": "R",
        "units": "1 hour",
        "description": "Total drive power-on hours."
      },
      "0041": {
        "name": "kWh Monitor (Low Word)",
        "address_hex": "0041",
        "address_dec": 65,
        "access": "R",
        "units": "1 kWh",
        "description": "Cumulative energy consumption, low 16-bit word."
      },
      "0042": {
        "name": "kWh Monitor (High Word)",
        "address_hex": "0042",
        "address_dec": 66,
        "access": "R",
        "units": "1 kWh",
        "description": "Cumulative energy consumption, high 16-bit word. Full value = (0042 << 16) | 0041."
      },
      "0044": {
        "name": "PID Feedback Monitor",
        "address_hex": "0044",
        "address_dec": 68,
        "access": "R",
        "units": "0.01%",
        "description": "PID feedback value."
      },
      "0045": {
        "name": "PID Input (Error) Monitor",
        "address_hex": "0045",
        "address_dec": 69,
        "access": "R",
        "units": "0.01%",
        "description": "PID input (setpoint minus feedback)."
      },
      "0046": {
        "name": "PID Output Monitor",
        "address_hex": "0046",
        "address_dec": 70,
        "access": "R",
        "units": "0.01%",
        "description": "PID controller output."
      }
    }
  },
  "parameter_registers": {
    "description": "Drive parameters are mapped to holding registers by their parameter address. Use function code 03 to read, 06 or 10 to write. Writing parameters while the drive is running may be restricted depending on the parameter.",
    "address_formula": "Register address = MEMOBUS parameter address as listed in the A1000 technical manual appendix. Parameters are grouped by function group (A, b, C, d, E, F, H, L, n, o, q, r, T, U). Each parameter has a unique 4-digit hex register address.",
    "common_parameters": {
      "0100": { "parameter": "A1-02", "name": "Control Method",         "description": "0=V/f, 1=V/f w/ PG, 2=OLV, 3=CLV, 6=AOLV, 7=CLV/PM" },
      "0101": { "parameter": "A1-03", "name": "Initialize",             "description": "2220 = 2-wire init, 3330 = 3-wire init, 5550 = user init" },
      "0180": { "parameter": "b1-01", "name": "Frequency Ref Source",   "description": "0=keypad, 1=analog, 2=Modbus, 3=option, 4=pulse" },
      "0181": { "parameter": "b1-02", "name": "Run Command Source",     "description": "0=keypad, 1=terminals, 2=Modbus, 3=option" },
      "0183": { "parameter": "b1-04", "name": "Reverse Operation",      "description": "0=enabled, 1=disabled" },
      "0201": { "parameter": "C1-01", "name": "Accel Time 1",           "description": "0.0–6000.0 s", "units": "0.1 s" },
      "0202": { "parameter": "C1-02", "name": "Decel Time 1",           "description": "0.0–6000.0 s", "units": "0.1 s" },
      "0203": { "parameter": "C1-03", "name": "Accel Time 2",           "description": "0.0–6000.0 s", "units": "0.1 s" },
      "0204": { "parameter": "C1-04", "name": "Decel Time 2",           "description": "0.0–6000.0 s", "units": "0.1 s" },
      "0280": { "parameter": "d1-01", "name": "Frequency Reference 1",  "description": "Preset speed 1", "units": "0.01 Hz" },
      "0281": { "parameter": "d1-02", "name": "Frequency Reference 2",  "description": "Preset speed 2", "units": "0.01 Hz" },
      "0282": { "parameter": "d1-03", "name": "Frequency Reference 3",  "description": "Preset speed 3", "units": "0.01 Hz" },
      "0283": { "parameter": "d1-04", "name": "Frequency Reference 4",  "description": "Preset speed 4", "units": "0.01 Hz" },
      "0291": { "parameter": "d2-01", "name": "Frequency Upper Limit",  "description": "Maximum output frequency limit",  "units": "0.1%" },
      "0292": { "parameter": "d2-02", "name": "Frequency Lower Limit",  "description": "Minimum output frequency limit", "units": "0.1%" },
      "0300": { "parameter": "E1-01", "name": "Input Voltage Setting",  "description": "Nominal motor input voltage", "units": "1 V" },
      "0303": { "parameter": "E1-04", "name": "Max Output Frequency",   "description": "FMAX", "units": "0.01 Hz" },
      "0304": { "parameter": "E1-05", "name": "Max Output Voltage",     "description": "VMAX", "units": "0.1 V" },
      "0308": { "parameter": "E1-09", "name": "Min Output Frequency",   "description": "FMIN", "units": "0.01 Hz" },
      "0310": { "parameter": "E2-01", "name": "Motor Rated Current",    "description": "FLA", "units": "0.01 A" },
      "0311": { "parameter": "E2-02", "name": "Motor Rated Slip",       "description": "Rated slip frequency", "units": "0.01 Hz" },
      "0312": { "parameter": "E2-03", "name": "Motor No-Load Current",  "description": "Magnetising current", "units": "0.01 A" },
      "0313": { "parameter": "E2-04", "name": "Motor Poles",            "description": "Number of motor poles" },
      "0314": { "parameter": "E2-05", "name": "Motor Line-to-Line Resistance", "description": "Phase resistance", "units": "0.001 Ω" },
      "0320": { "parameter": "H5-01", "name": "Slave Address",          "description": "1–1F (hex)" },
      "0321": { "parameter": "H5-02", "name": "Baud Rate Select",       "description": "0=1200 … 5=38400" },
      "0322": { "parameter": "H5-03", "name": "Communication Parity",   "description": "0=8-N-2, 1=8-E-1, 2=8-O-1, 3=8-N-1" },
      "0323": { "parameter": "H5-04", "name": "Stop on Comm Error",     "description": "0=ramp, 1=coast, 2=fast stop, 3=continue" },
      "0324": { "parameter": "H5-05", "name": "Comm Fault Detection",   "description": "0=disabled, 1=enabled" },
      "0325": { "parameter": "H5-06", "name": "TX Wait Time",           "description": "5–65 ms", "units": "1 ms" },
      "0326": { "parameter": "H5-07", "name": "RTS Control",            "description": "0=always ON, 1=RTS controlled" }
    }
  },
  "example_messages": {
    "description": "Raw Modbus RTU byte sequences. CRC bytes shown as [CRC_LO, CRC_HI] (CRC-16/IBM, little-endian).",
    "read_status_register": {
      "description": "Read the status register (0x0020) from slave 01",
      "request":  { "bytes": "01 03 00 20 00 01 [CRC]", "breakdown": { "01": "slave address", "03": "function read holding reg", "00 20": "start address 0x0020", "00 01": "quantity 1 register", "[CRC]": "85 C4" } },
      "response": { "bytes": "01 03 02 XX XX [CRC]",     "breakdown": { "01": "slave address", "03": "function echo", "02": "byte count (2)", "XX XX": "status word value", "[CRC]": "calculated" } }
    },
    "read_output_frequency": {
      "description": "Read output frequency register (0x0025) from slave 01",
      "request":  { "bytes": "01 03 00 25 00 01 [CRC]", "breakdown": { "00 25": "register 0x0025 (output freq)", "[CRC]": "94 04" } },
      "response": { "bytes": "01 03 02 17 70 [CRC]",     "breakdown": { "17 70": "0x1770 = 6000 = 60.00 Hz" } }
    },
    "write_frequency_reference_6000": {
      "description": "Set frequency reference to 60.00 Hz (6000 = 0x1770) on slave 01",
      "request":  { "bytes": "01 06 00 02 17 70 [CRC]", "breakdown": { "06": "function write single reg", "00 02": "register 0x0002 (freq ref)", "17 70": "6000 = 60.00 Hz", "[CRC]": "63 27" } },
      "response": { "bytes": "01 06 00 02 17 70 [CRC]",  "breakdown": { "description": "Echo of request on success" } }
    },
    "run_forward": {
      "description": "Run forward: write command word 0x0001 to register 0x0001",
      "request":  { "bytes": "01 06 00 01 00 01 [CRC]", "breakdown": { "00 01": "register 0x0001 (command)", "00 01": "command word bit 0 set = forward run", "[CRC]": "D8 0A" } },
      "response": { "bytes": "01 06 00 01 00 01 [CRC]",  "breakdown": { "description": "Echo on success" } }
    },
    "run_reverse": {
      "description": "Run reverse: write command word 0x0002",
      "request":  { "bytes": "01 06 00 01 00 02 [CRC]", "breakdown": { "00 02": "command word bit 1 set = reverse run" } },
      "response": { "bytes": "01 06 00 01 00 02 [CRC]" }
    },
    "stop": {
      "description": "Stop: write command word 0x0000",
      "request":  { "bytes": "01 06 00 01 00 00 [CRC]" },
      "response": { "bytes": "01 06 00 01 00 00 [CRC]" }
    },
    "fault_reset": {
      "description": "Reset fault: write command word 0x0008 (bit 3 set), then 0x0000 to clear",
      "step1_request":  { "bytes": "01 06 00 01 00 08 [CRC]" },
      "step1_response": { "bytes": "01 06 00 01 00 08 [CRC]" },
      "step2_request":  { "bytes": "01 06 00 01 00 00 [CRC]" },
      "step2_response": { "bytes": "01 06 00 01 00 00 [CRC]" }
    },
    "run_forward_at_speed": {
      "description": "Write command and frequency reference together using function code 10 (write multiple registers)",
      "request":  { "bytes": "01 10 00 01 00 02 04 00 01 17 70 [CRC]", "breakdown": { "01 10": "slave 01, FC 16", "00 01": "start register 0x0001", "00 02": "2 registers", "04": "4 bytes follow", "00 01": "command word = forward run", "17 70": "freq ref = 6000 = 60.00 Hz" } },
      "response": { "bytes": "01 10 00 01 00 02 [CRC]", "breakdown": { "description": "Echo start address and quantity on success" } }
    },
    "loopback_test": {
      "description": "Loopback diagnostic (FC 08, sub-function 0x0000) to slave 01",
      "request":  { "bytes": "01 08 00 00 AB CD [CRC]" },
      "response": { "bytes": "01 08 00 00 AB CD [CRC]", "breakdown": { "description": "Echoes the two data bytes unchanged" } }
    },
    "read_multiple_monitors": {
      "description": "Read 6 monitor registers starting at 0x0025 (freq, current, voltage, DC bus, reserved, power)",
      "request":  { "bytes": "01 03 00 25 00 06 [CRC]" },
      "response": { "bytes": "01 03 0C [12 data bytes] [CRC]", "breakdown": { "0C": "12 bytes = 6 registers × 2 bytes each" } }
    }
  },
  "exception_responses": {
    "description": "If the drive cannot process a request, it responds with the function code ORed with 0x80 followed by an exception code.",
    "format": "Slave Addr | (FC | 0x80) | Exception Code | CRC",
    "example": "01 83 02 [CRC] = slave 01, FC 03 error, exception 02 (illegal data address)",
    "codes": {
      "01": { "name": "Illegal Function",        "description": "The function code is not supported by the drive." },
      "02": { "name": "Illegal Data Address",    "description": "The register address is out of range or does not exist." },
      "03": { "name": "Illegal Data Value",      "description": "The data value is out of the parameter's allowable range." },
      "04": { "name": "Slave Device Failure",    "description": "Drive could not execute the request due to an internal error." },
      "05": { "name": "Acknowledge",             "description": "Drive accepted the command but processing will take time. Poll for completion." },
      "06": { "name": "Slave Device Busy",       "description": "Drive is busy processing a previous command." }
    }
  },
  "fault_codes": {
    "description": "Values returned in register 0x0021 (fault code) when the drive trips.",
    "codes": {
      "00": "No fault",
      "01": "oC  — Overcurrent",
      "02": "ov  — Overvoltage",
      "03": "oH1 — Heatsink overheat",
      "04": "oH2 — Internal overheat",
      "05": "oL1 — Motor overload (OL1)",
      "06": "oL2 — Drive overload (OL2)",
      "07": "oL3 — Overtorque 1",
      "08": "oL4 — Overtorque 2",
      "09": "rr  — DB transistor fault",
      "0A": "rH  — DB resistor overheat",
      "0B": "EF  — External fault",
      "0C": "EF0 — External fault (Modbus)",
      "0D": "EF1 — External fault (terminal S1)",
      "0E": "EF2 — External fault (terminal S2)",
      "0F": "EF3 — External fault (terminal S3)",
      "10": "PF  — Input phase loss",
      "11": "LF  — Output phase loss",
      "12": "oH3 — Motor overheat (thermistor PTC)",
      "13": "oS  — Overspeed",
      "14": "dEv — Speed deviation",
      "15": "PGo — PG open (encoder disconnected)",
      "17": "CE  — Modbus communication error",
      "18": "bUS — Option communication error",
      "19": "CALL — Serial comm wait",
      "1A": "UL3 — Undertorque 1",
      "1B": "UL4 — Undertorque 2",
      "1E": "SC  — Short circuit / ground fault",
      "1F": "UV1 — DC bus undervoltage",
      "20": "UV2 — Control power supply undervoltage",
      "21": "UV3 — Soft-charge circuit fault",
      "22": "SE  — EEPROM write error",
      "23": "CPF — Control circuit fault",
      "24": "oH4 — Drive overheat pre-alarm",
      "2F": "STo — Pull-out detection (PM motor)",
      "30": "EtH — Motor overheat (thermistor NTC)",
      "31": "LSo — Low speed detection",
      "38": "oL7 — High slip braking overload",
      "3A": "HCA — High current alarm"
    }
  },
  "scaling_summary": {
    "frequency":       { "unit": "0.01 Hz",  "example": "6000 = 60.00 Hz" },
    "current":         { "unit": "0.1 A",    "example": "150 = 15.0 A" },
    "voltage":         { "unit": "0.1 V",    "example": "2400 = 240.0 V" },
